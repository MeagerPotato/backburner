{
  "name": "backburner-cc",
  "version": "0.2.0",
  "description": "Paces your Claude plan's weekly usage: daily reserves, a weekly cap, and a task queue that runs when you have usage to spare.",
  "license": "MIT",
  "author": "Allen Hsieh",
  "homepage": "https://github.com/MeagerPotato/backburner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeagerPotato/backburner.git"
  },
  "bugs": {
    "url": "https://github.com/MeagerPotato/backburner/issues"
  },
  "type": "module",
  "bin": {
    "backburner": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "usage",
    "rate-limits",
    "queue",
    "scheduler",
    "mcp"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
